<Application x:Class="MemoryBlackHole.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <Application.Resources>
        <ResourceDictionary>
            <!-- 记忆黑洞自定义配色（纯 WPF，不依赖 MaterialDesign）-->
            <Color x:Key="BgColor">#1B1F27</Color>
            <Color x:Key="CardColor">#272D3A</Color>
            <Color x:Key="SideColor">#242936</Color>
            <Color x:Key="AccentColor">#7C4DFF</Color>
            <Color x:Key="TextColor">#E6E6E6</Color>
            <Color x:Key="DimColor">#7E8496</Color>
            <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
            <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
            <SolidColorBrush x:Key="SideBrush" Color="{StaticResource SideColor}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
            <SolidColorBrush x:Key="DimBrush" Color="{StaticResource DimColor}" />

            <FontFamily x:Key="AppFont">Microsoft YaHei UI, Segoe UI, Microsoft YaHei, sans-serif</FontFamily>
            <sys:Double x:Key="AppFontSize">14</sys:Double>

            <Style TargetType="TextBox">
                <Setter Property="Background" Value="#232B3E"/>
                <Setter Property="Foreground" Value="#EEF1FF"/>
                <Setter Property="BorderBrush" Value="#414D70"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="10,0"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              CanContentScroll="False"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="InputBorder" Property="BorderBrush" Value="#8E7CFF"/>
                                    <Setter TargetName="InputBorder" Property="BorderThickness" Value="1.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="PasswordBox">
                <Setter Property="Background" Value="#232B3E"/>
                <Setter Property="Foreground" Value="#EEF1FF"/>
                <Setter Property="BorderBrush" Value="#414D70"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="10,0"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              CanContentScroll="False"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="InputBorder" Property="BorderBrush" Value="#8E7CFF"/>
                                    <Setter TargetName="InputBorder" Property="BorderThickness" Value="1.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 全局暗色滚动条样式 -->
            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="#232B3E"/>
                <Setter Property="Foreground" Value="#3D4A78"/>
                <Setter Property="Width" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="#232B3E">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Track x:Name="PART_Track" Grid.Row="0">
                                    <Track.Thumb>
                                        <Thumb Background="#3D4A78" BorderThickness="0">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="#3D4A78" CornerRadius="4" Width="6" Height="Auto"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ScrollViewer">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#3D4A78"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>