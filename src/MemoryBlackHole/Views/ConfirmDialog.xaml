<Window x:Class="MemoryBlackHole.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinWidth="340" MinHeight="120" MaxWidth="600" MaxHeight="400"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent" Foreground="#E9ECF5">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="#11182A" BorderBrush="#394766" BorderThickness="1" CornerRadius="16" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" Text="记忆黑洞" FontSize="19" Foreground="White" FontWeight="SemiBold"/>
            <TextBlock x:Name="MessageText" Grid.Row="1" TextWrapping="Wrap" Foreground="#B8C1D8" FontSize="13" Margin="0,12,0,16"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="取消" Width="80" Margin="0,0,10,0" Click="Cancel_Click"
                        Background="Transparent" Foreground="#C5CBE0" BorderBrush="#34405D" BorderThickness="1" Padding="10,7"/>
                <Button x:Name="ConfirmButton" Content="确定" Width="80" Click="Confirm_Click"
                        Background="#6D5DF7" Foreground="White" BorderThickness="0" Padding="10,7"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>