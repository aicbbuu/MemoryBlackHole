<Window x:Class="MemoryBlackHole.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:models="clr-namespace:MemoryBlackHole.Models"
        xmlns:converters="clr-namespace:MemoryBlackHole.Converters"
        Title="记忆黑洞" Width="950" Height="500" MinWidth="360" MinHeight="280"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="True" Background="Transparent" Foreground="#E9ECF5"
        AllowDrop="True" Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" FontSize="14">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <converters:ContentOrFileNameConverter x:Key="ContentOrFileName"/>
        <LinearGradientBrush x:Key="WindowBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#151820" Offset="0"/>
            <GradientStop Color="#1F2638" Offset="0.55"/>
            <GradientStop Color="#14171E" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#BBA7FF" Offset="0"/>
            <GradientStop Color="#7564F7" Offset="0.48"/>
            <GradientStop Color="#39D7FF" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="MutedBrush" Color="#97A1BB"/>
        <SolidColorBrush x:Key="LineBrush" Color="#3E4A6C"/>

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F5F7FF"/>
            <Setter Property="Background" Value="#303B56"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBorder" Background="{TemplateBinding Background}" CornerRadius="18" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#434F79"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C3CBDF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#37436A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StarButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#2A3452"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#554BBA"/>
            <Setter Property="Width" Value="62"/>
            <Setter Property="Height" Value="62"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="StarBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="31">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StarBorder" Property="Background" Value="#475380"/>
                                <Setter TargetName="StarBorder" Property="BorderBrush" Value="#A99BFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CircleIconButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#27304A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#495678"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CircleBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CircleBorder" Property="Background" Value="#475380"/>
                                <Setter TargetName="CircleBorder" Property="BorderBrush" Value="#A99BFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ResultTemplate" DataType="{x:Type models:MemoryItem}">
            <Border Background="#232B3E" BorderBrush="#414E72" BorderThickness="1"
                    CornerRadius="12" Padding="16" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- v3.1.4: 缩略图(图片类型有 Thumbnail BLOB 时显示,否则占位 emoji) -->
                    <Border Width="42" Height="42" CornerRadius="10" Background="#6D5DF7">
                        <Grid>
                            <TextBlock Text="✦" FontSize="20" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding ThumbnailIconVisibility}"/>
                            <Image Source="{Binding ThumbnailImage}" Width="42" Height="42"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   SnapsToDevicePixels="True"
                                   Visibility="{Binding ThumbnailImageVisibility}"/>
                        </Grid>
                    </Border>
                    <Grid Grid.Column="1" Margin="12,0,16,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- v3.0.3 重打(问题3): 主行用 ContentOrFileName Converter 区分:
                              Text/Link → Content(Converter 已规范化,单行),其它类型 → OriginalFileName。
                              父容器由 StackPanel(给子元素无限测量宽)改为 Grid(* 列有限宽),
                              TextBlock HorizontalAlignment=Stretch 即可真正跟随可用列宽,触发
                              TextTrimming=CharacterEllipsis 让超出部分以 … 结尾(去掉写死的 MaxWidth=320)。 -->
                        <TextBlock Text="{Binding Converter={StaticResource ContentOrFileName}}" FontSize="15" FontWeight="SemiBold" Foreground="#F4F6FF"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   HorizontalAlignment="Stretch"
                                   ToolTip="{Binding DisplayText}"/>
                        <TextBlock Grid.Row="1" Text="{Binding Tags}" FontSize="12" Foreground="#9D8BFF"
                                   TextWrapping="Wrap" MaxHeight="20" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="2" Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" FontSize="11" Foreground="#7B87A6" Margin="0,6,0,0"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="WindowFrame" Background="{StaticResource WindowBackground}" CornerRadius="18"
            ClipToBounds="True" SizeChanged="WindowFrame_SizeChanged">
        <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 自定义标题栏 -->
        <Grid Grid.Row="0" Background="#181D2A" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                <Grid Width="34" Height="34">
                    <Ellipse Fill="{StaticResource AccentGradient}"/>
                    <Ellipse Width="22" Height="22" Fill="#151820" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Ellipse Width="9" Height="9" Fill="#FFE7A6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Ellipse Width="29" Height="8" Stroke="#FFF0C2" StrokeThickness="1.4" Opacity="0.85"
                             HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><RotateTransform Angle="-18"/></Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>
                <TextBlock Text="记忆黑洞" FontSize="15" FontWeight="SemiBold"
                           Foreground="#F5F7FF" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="LOCAL MEMORY VAULT" FontSize="10"
                       Foreground="#67749B" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,10,0">
                <Button Content="—" Style="{StaticResource WindowButton}" Click="Minimize_Click"/>
                <Button x:Name="MaximizeButton" Content="□" Style="{StaticResource WindowButton}" Click="Maximize_Click"/>
                <Button Content="×" Style="{StaticResource WindowButton}" Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <!-- 正面：沉浸式黑洞入口 -->
        <Grid x:Name="FrontFace" Grid.Row="1" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><ScaleTransform x:Name="FlipScale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
            <Canvas x:Name="FrontCanvas" Background="Transparent"
                    MouseLeftButtonDown="FrontCanvas_MouseLeftButtonDown"/>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,42">
                <TextBlock Text="把记忆交给黑洞" FontSize="28" FontWeight="Light"
                           Foreground="#F3F5FF" HorizontalAlignment="Center"/>
                <TextBlock Text="纯本地「万物收纳盒」——随手记•随时找" FontSize="13"
                           Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,9,0,0"/>
                <TextBlock Text="双击黑洞探索记忆空间" FontSize="11"
                           Foreground="#647098" HorizontalAlignment="Center" Margin="0,16,0,0"/>
            </StackPanel>
            <Button Style="{StaticResource StarButton}" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="54,40,0,0" Click="FrontAdd_Click" ToolTip="新增记忆">
                <TextBlock Text="✦" FontSize="28" Foreground="#F5D77C"/>
            </Button>
            <TextBlock Text="新增记忆" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Margin="66,108,0,0" Foreground="#9AA5C1" FontSize="11"/>

            <!-- 右下角 GitHub 问号图标 + 版本号 -->
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,26,26" Orientation="Horizontal">
                <TextBlock x:Name="VersionText" Text="v1.0.0" FontSize="10" Foreground="#5F6B93"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Style="{StaticResource CircleIconButton}" Click="OpenGitHub_Click" ToolTip="项目主页">
                    <TextBlock Text="?" FontSize="16" FontWeight="Bold" Foreground="#A5B0C8"/>
                </Button>
            </StackPanel>

            <!-- v3.1.2/3 左下角背景音乐播放器:默认折叠成小圆钮(音符),点击展开为紧凑控制面板,点曲名展开播放列表 -->
            <Grid x:Name="MusicPlayer" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="26,0,0,26">
                <Grid.Resources>
                    <Style x:Key="MusicGhostButton" TargetType="Button">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Foreground" Value="#97A1BB"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="B" Property="Background" Value="#2B3550"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Grid.Resources>
                <Button x:Name="MusicToggle" Style="{StaticResource CircleIconButton}" Click="MusicToggle_Click"
                        ToolTip="背景音乐">
                    <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#A5B0C8"/>
                </Button>
                <Border x:Name="MusicPanel" Visibility="Collapsed" Background="#B0171D2A" CornerRadius="12"
                        Padding="12" Width="300" Cursor="Arrow">
                    <StackPanel>
                        <!-- 标题行:点曲名展开/收起播放列表 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Cursor="Hand" MouseLeftButtonUp="MusicTitleButton_Click">
                                <TextBlock x:Name="MusicTitle" Text="背景音乐" Foreground="#E9ECF5" FontSize="13"
                                           TextTrimming="CharacterEllipsis" MaxWidth="200" VerticalAlignment="Center"/>
                                <TextBlock Text="▾" Foreground="#9D8BFF" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="—" Width="26" Height="24" Click="MusicToggle_Click"
                                    Style="{StaticResource MusicGhostButton}"/>
                        </Grid>
                        <!-- 播放列表(点曲名展开;当前项高亮,点击切歌) -->
                        <ListBox x:Name="MusicList" Visibility="Collapsed" Margin="0,6,0,0" MaxHeight="160"
                                 Background="#E0232B3E" BorderBrush="#414D70" BorderThickness="1"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 SelectionChanged="MusicList_SelectionChanged" Foreground="#CED5E7" FontSize="12">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="8,5"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#6D5DF7"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <!-- 播放控制:上一首 / 播放·暂停(突出) / 下一首 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,2">
                            <Button x:Name="MusicPrevButton" Style="{StaticResource CircleIconButton}" Click="MusicPrev_Click" ToolTip="上一首">
                                <TextBlock Text="&#xE892;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#C4CCE0"/>
                            </Button>
                            <Button x:Name="MusicPlayPause" Style="{StaticResource CircleIconButton}" Width="46" Height="46"
                                    Margin="10,0,10,0" Click="MusicPlayPause_Click" Background="#6D5DF7" ToolTip="播放/暂停">
                                <TextBlock x:Name="MusicPlayPauseIcon" Text="&#xE768;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="16" Foreground="White"/>
                            </Button>
                            <Button x:Name="MusicNextButton" Style="{StaticResource CircleIconButton}" Click="MusicNext_Click" ToolTip="下一首">
                                <TextBlock Text="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#C4CCE0"/>
                            </Button>
                        </StackPanel>
                        <!-- 进度条 + 时间 -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="MusicProgress" Minimum="0" Maximum="1" Value="0" VerticalAlignment="Center"
                                    PreviewMouseLeftButtonDown="MusicProgress_PreviewMouseLeftButtonDown"
                                    PreviewMouseLeftButtonUp="MusicProgress_PreviewMouseLeftButtonUp"
                                    ValueChanged="MusicProgress_ValueChanged"/>
                            <TextBlock x:Name="MusicTime" Grid.Column="1" Text="00:00 / 00:00" Foreground="#A5B0C8"
                                       FontSize="10" Margin="8,0,2,0" VerticalAlignment="Center"/>
                        </Grid>
                        <!-- 音量 -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#A5B0C8"
                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <Slider x:Name="MusicVolume" Grid.Column="1" Minimum="0" Maximum="100" Value="50"
                                    ValueChanged="MusicVolume_ValueChanged" ToolTip="音量"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- 背面：黑洞 + 搜索 + 标签侧栏 + 统计 -->
        <Grid x:Name="BackFace" Grid.Row="1" Visibility="Collapsed"
              Background="#181B24" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><ScaleTransform x:Name="BackFlipScale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
            <Canvas x:Name="BackCanvas" Background="Transparent"/>
            <Grid Margin="34,32,34,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- 左侧：返回按钮 + 标签列表 + 统计 -->
                <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,6,16,0">
                    <Button Content="← 返回黑洞" Style="{StaticResource PillButton}"
                            HorizontalAlignment="Left" Click="BackToFront"/>
                    <!-- 分隔 -->
                    <Rectangle Height="1" Fill="#303B56" Margin="0,18,0,14"/>
                    <TextBlock Text="📌 标签" FontSize="12" Foreground="#97A1BB" Margin="0,0,0,8"/>
                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="TagsList" FontSize="13">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="6,5" Margin="0,1" CornerRadius="8"
                                            Background="#232B3E" Cursor="Hand"
                                            MouseLeftButtonDown="TagItem_MouseDown">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Key}" Foreground="#CED5E7"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Value, StringFormat='({0})'}"
                                                       Foreground="#9D8BFF" FontSize="11" Margin="8,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <!-- 统计 -->
                    <Rectangle Height="1" Fill="#303B56" Margin="0,10,0,10"/>
                    <TextBlock x:Name="StatsText" Text="加载中…" FontSize="11"
                               Foreground="#7B87A6" TextWrapping="Wrap"/>
                </StackPanel>
                <!-- 右侧：搜索 + 结果 -->
                <Grid Grid.Column="1" VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="探索记忆" FontSize="25" FontWeight="Light"
                               Foreground="#F3F5FF" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Text="输入关键词，搜索记忆" FontSize="13"
                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,8,0,20"/>
                    <Border Grid.Row="2" Height="54" CornerRadius="27" Background="#232B3E"
                            BorderBrush="#495678" BorderThickness="1" Padding="20,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="⌕" FontSize="24" Foreground="#9D8BFF"
                                       VerticalAlignment="Center" Margin="0,0,13,0"/>
                            <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                     Foreground="#F4F6FF" CaretBrush="#A78BFA" FontSize="15"
                                     VerticalContentAlignment="Center" KeyDown="SearchBox_KeyDown"/>
                            <TextBlock Grid.Column="2" Text="Enter" FontSize="11" Foreground="#727FA0"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <!-- v3.0.8: 搜索范围提示(全局 / 标签:xxx)醒目色块,让用户知道当前搜的是哪 -->
                    <Border Grid.Row="3" x:Name="SearchScopeBar" Margin="0,8,0,0" Padding="10,6"
                            CornerRadius="6" Background="#354060" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="搜索范围:" FontSize="11" Foreground="#97A1BB" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SearchScopeText" Text="全局搜索" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#9D8BFF" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Row="4" x:Name="SearchStatus" Text="黑洞正在等待你的关键词" FontSize="12"
                               Foreground="#727FA2" HorizontalAlignment="Center" Margin="0,10,0,10"/>
                    <!-- v3.0.1: ResultsScrollViewer 占满剩余高度,不再写死 360 -->
                    <ScrollViewer Grid.Row="5" x:Name="ResultsScrollViewer" VerticalScrollBarVisibility="Auto"
                                  CanContentScroll="True"
                                  PreviewMouseWheel="ResultsScrollViewer_PreviewMouseWheel">
                        <ItemsControl x:Name="ResultsList" ItemTemplate="{StaticResource ResultTemplate}"
                                      Opacity="0.80" MouseDoubleClick="ResultsList_MouseDoubleClick"
                                      ScrollViewer.CanContentScroll="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      VirtualizingPanel.ScrollUnit="Pixel">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
        </Grid>
    </Border>
</Window>
