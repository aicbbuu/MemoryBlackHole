<Window x:Class="MemoryBlackHole.Views.EditMemoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑" Width="520" Height="430" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent" Foreground="#E9ECF5">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#303B59" BorderThickness="1" CornerRadius="16" Background="#0F1424" Padding="26">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="编辑" FontSize="22" FontWeight="Light" Foreground="White"/>
            <TextBlock x:Name="TypeText" Grid.Row="1" Foreground="#9D8BFF" FontSize="12" Margin="0,8,0,16"/>
            <TextBox x:Name="ContentBox" Grid.Row="2" Background="#171D30" BorderBrush="#303B59"
                     Foreground="White" Padding="11" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <TextBlock Text="标签（可选，用逗号分隔）" Foreground="#8991A8" FontSize="12" Margin="0,0,0,5"/>
                <TextBox x:Name="TagsBox" Height="38" Background="#171D30" BorderBrush="#303B59"
                         Foreground="White" Padding="10,8"/>
                <TextBlock x:Name="FileText" Foreground="#71809F" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="取消" Width="80" Margin="0,0,10,0" Click="Cancel_Click" Background="Transparent" Foreground="#C5CBE0" BorderBrush="#34405D" BorderThickness="1" Padding="10,8"/>
                <Button Content="保存修改" Width="105" Click="Save_Click" Background="#6D5DF7" Foreground="White" BorderThickness="0" Padding="10,8"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
