<Window x:Class="MemoryBlackHole.Views.EditMemoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="编辑" Width="600" Height="500" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent" Foreground="#E9ECF5">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="16"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#414D70" BorderThickness="1" CornerRadius="16" Background="#1C2333" Padding="26">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="编辑" FontSize="22" FontWeight="Light" Foreground="White"/>
            <TextBlock x:Name="TypeText" Grid.Row="1" Foreground="#9D8BFF" FontSize="12" Margin="0,8,0,16"/>
            <TextBox x:Name="ContentBox" Grid.Row="2" Background="#232B3E" BorderBrush="#414D70"
                     Foreground="White" Padding="11" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <TextBlock Text="标签（可自定义，用逗号分隔）" Foreground="#97A1BB" FontSize="12" Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- v3.1.0 兼容 AddItemDialog：左侧固定类型词(不可编辑)，标签框只装用户自定义标签 -->
                    <Border Background="#6D5DF7" CornerRadius="4" Padding="8,4" VerticalAlignment="Center" Margin="0,0,6,0">
                        <TextBlock x:Name="FixedTagLabel" Text="文本" Foreground="White" FontSize="13"/>
                    </Border>
                    <TextBox Grid.Column="1" x:Name="TagsBox" Height="28" Background="#232B3E" BorderBrush="#414D70"
                             Foreground="White" Padding="10,6" VerticalContentAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="FileText" Foreground="#8793B2" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="取消" Width="80" Margin="0,0,10,0" Click="Cancel_Click" Background="Transparent" Foreground="#CED5E7" BorderBrush="#485574" BorderThickness="1" Padding="10,8"/>
                <Button Content="保存修改" Width="105" Click="Save_Click" Background="#6D5DF7" Foreground="White" BorderThickness="0" Padding="10,8"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
