<Window x:Class="MemoryBlackHole.Views.PreviewMemoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="查看记忆" Width="600" Height="400" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="#1C2333" Foreground="#E9ECF5">
    <shell:WindowChrome.WindowChrome>
        <!-- v3.0.3 重打(问题2): CornerRadius 与外层 Border CornerRadius=12 保持一致,四角圆角才完整;
             ResizeBorderThickness 改 0(用户失去边缘拖拽改大小,只能拖标题栏/最大化) -->
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="12"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="DialogWindowButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C3CBDF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#37436A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!-- v3.1.3(问题2): 查看记忆弹窗改为不透明(去掉 AllowsTransparency + Opacity=0.80),
         背景用实色 #1C2333,图片/视频/文本显示清晰;外层 Border 圆角由 WindowChrome/DWM 提供。
         x:Name="WindowFrame" 供 StateChanged 最大化时补偿铺满工作区 -->
    <Border x:Name="WindowFrame" BorderBrush="#414D70" BorderThickness="1" CornerRadius="12" Background="#1C2333">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- v3.0.3(问题2): 标题栏背景用带顶部左右圆角的 Border,不再以实心矩形盖住外层 Border 的顶部圆角 -->
            <Border Grid.Row="0" Background="#181D2A" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="查看记忆" FontSize="13" FontWeight="SemiBold"
                               Foreground="#F5F7FF" VerticalAlignment="Center" Margin="18,0,0,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,6,0">
                        <Button Content="—" Style="{StaticResource DialogWindowButton}" Click="Minimize_Click"/>
                        <Button x:Name="MaximizeButton" Content="□" Style="{StaticResource DialogWindowButton}" Click="Maximize_Click"/>
                        <Button Content="×" Style="{StaticResource DialogWindowButton}" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="1" Padding="26">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="TitleText" Text="查看记忆" FontSize="22" FontWeight="Light" Foreground="White"/>
                    <TextBlock x:Name="MetaText" Grid.Row="1" Foreground="#9D8BFF" FontSize="12" Margin="0,8,0,16"/>
                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <!-- v3.1.3(问题3): 行0=内容画面(* 填满), 行1=播放控制条(Auto, 在画面下方,不遮挡视频) -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <RichTextBox x:Name="MarkdownViewer" Visibility="Collapsed"
                                  IsReadOnly="True" BorderThickness="0"
                                  Background="Transparent" Foreground="#E9ECF5"
                                  VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                  VerticalScrollBarVisibility="Auto" FontSize="14"/>
                        <StackPanel x:Name="LinkPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🔗 链接记忆" FontSize="18" Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="LinkUrlText" Foreground="#9D8BFF" TextWrapping="Wrap"
                                       TextAlignment="Center" Margin="0,12,0,8" FontSize="13"/>
                            <!-- v3.0.3 重打: 增加提示文字,引导用户使用下方按钮打开 -->
                            <TextBlock Text="(点击下方在浏览器中打开)" Foreground="#97A1BB" FontSize="11"
                                       TextAlignment="Center" Margin="0,0,0,12"/>
                            <Button Content="打开链接" Width="110" Click="OpenLink_Click"
                                    Background="#6D5DF7" Foreground="White" BorderThickness="0" Padding="10,8"/>
                        </StackPanel>
                        <Image x:Name="ImagePreview" Stretch="Uniform" Visibility="Collapsed"/>
                        <!-- v3.1.2: 视频改用 MediaPlayer + VideoDrawing 经 DrawingBrush 渲染到 Rectangle(WPF 保留模式合成),
                             使视频帧在 AllowsTransparency 透明分层窗口中也能正常显示;音频仅音频,无画面,Fill 不用。 -->
                        <Rectangle x:Name="VideoSurface" Fill="Black" Visibility="Collapsed"/>
                        <!-- v3.1.3(问题3): 播放控制条位于画面下方行1(Auto),不遮挡视频;仅媒体类型显示 -->
                        <Border x:Name="MediaControls" Grid.Row="1" Visibility="Collapsed"
                                HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                Background="#CC181D2A" CornerRadius="8" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- v3.1.3(问题4): 现代图标用 Segoe MDL2 Assets(系统自带,免费可商用) -->
                                <Button x:Name="PlayPauseButton" Grid.Column="0" Content="&#xE769;" Width="38" Height="30"
                                        Click="PlayPause_Click" Background="#6D5DF7" Foreground="White"
                                        BorderThickness="0" Padding="0" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                <Slider x:Name="ProgressSlider" Grid.Column="1" VerticalAlignment="Center" Margin="10,0"
                                        Minimum="0" Maximum="1" Value="0"
                                        PreviewMouseLeftButtonDown="ProgressSlider_PreviewMouseLeftButtonDown"
                                        PreviewMouseLeftButtonUp="ProgressSlider_PreviewMouseLeftButtonUp"
                                        ValueChanged="ProgressSlider_ValueChanged"/>
                                <TextBlock x:Name="TimeText" Grid.Column="2" VerticalAlignment="Center" Foreground="#A5B0C8"
                                           FontSize="11" Margin="0,0,12,0" Text="00:00 / 00:00"/>
                                <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="#A5B0C8" FontSize="12"
                                           Text="&#xE767;" FontFamily="Segoe MDL2 Assets" Margin="0,0,4,0"/>
                                <Slider x:Name="VolumeSlider" Grid.Column="4" VerticalAlignment="Center" Width="90"
                                        Minimum="0" Maximum="100" Value="50"
                                        ValueChanged="VolumeSlider_ValueChanged" ToolTip="音量"/>
                            </Grid>
                        </Border>
                        <StackPanel x:Name="FileInfoPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="这是一个文件记忆" FontSize="18" Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="FileInfoText" Foreground="#A5B0C8" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"/>
                            <Button x:Name="OpenFileButton" Content="打开文件" Width="110" Margin="0,18,0,0" Click="OpenFile_Click"
                                    Background="#6D5DF7" Foreground="White" BorderThickness="0" Padding="10,8"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button x:Name="DeleteButton" Content="删除" Width="84" Margin="0,0,10,0" Click="Delete_Click"
                                Background="#4A1529" Foreground="#FF7E9E" BorderThickness="0" Padding="10,8"/>
                        <Button Content="编辑" Width="84" Margin="0,0,10,0" Click="Edit_Click"
                                Background="Transparent" Foreground="#CED5E7" BorderBrush="#485574" BorderThickness="1" Padding="10,8"/>
                        <Button Content="关闭" Width="84" Click="Close_Click"
                                Background="#6D5DF7" Foreground="White" BorderThickness="0" Padding="10,8"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>