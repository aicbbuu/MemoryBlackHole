<Window x:Class="MemoryBlackHole.Views.PreviewMemoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="查看记忆" Width="650" Height="520" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent" Foreground="#E9ECF5"
        Opacity="0.80"
        Loaded="Window_Loaded">
    <shell:WindowChrome.WindowChrome>
        <!-- v3.0.3 重打: ResizeBorderThickness 改 0(用户失去边缘拖拽改大小,只能拖标题栏/最大化);
             CornerRadius=10 让 Window 本身有系统圆角,配合外层 Border 圆角完整显示 -->
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="10"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="DialogWindowButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B8C1D8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#222A42"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!-- v3.0.3 重打: 外层 Border CornerRadius 从 16 改 12(配合 WindowChrome 圆角显示,不被 ResizeBorderThickness 6 像素吃掉) -->
    <Border BorderBrush="#303B59" BorderThickness="1" CornerRadius="12" Background="#E50F1424">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- v3.0.3: 自定义标题栏(WindowStyle=None 必需),支持拖动 + 最小化/最大化/关闭 -->
            <Grid Grid.Row="0" Background="#0C101D" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="查看记忆" FontSize="13" FontWeight="SemiBold"
                           Foreground="#F5F7FF" VerticalAlignment="Center" Margin="18,0,0,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,6,0">
                    <Button Content="—" Style="{StaticResource DialogWindowButton}" Click="Minimize_Click"/>
                    <Button x:Name="MaximizeButton" Content="□" Style="{StaticResource DialogWindowButton}" Click="Maximize_Click"/>
                    <Button Content="×" Style="{StaticResource DialogWindowButton}" Click="Close_Click"/>
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Padding="26">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="TitleText" Text="查看记忆" FontSize="22" FontWeight="Light" Foreground="White"/>
                    <TextBlock x:Name="MetaText" Grid.Row="1" Foreground="#9D8BFF" FontSize="12" Margin="0,8,0,16"/>
                    <Grid Grid.Row="2">
                        <RichTextBox x:Name="MarkdownViewer" Visibility="Collapsed"
                                  IsReadOnly="True" BorderThickness="0"
                                  Background="Transparent" Foreground="#E9ECF5"
                                  VerticalScrollBarVisibility="Auto" FontSize="14"/>
                        <StackPanel x:Name="LinkPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🔗 链接记忆" FontSize="18" Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="LinkUrlText" Foreground="#9D8BFF" TextWrapping="Wrap"
                                       TextAlignment="Center" Margin="0,12,0,8" FontSize="13"/>
                            <!-- v3.0.3 重打: 增加提示文字,引导用户使用下方按钮打开 -->
                            <TextBlock Text="(点击下方在浏览器中打开)" Foreground="#8991A8" FontSize="11"
                                       TextAlignment="Center" Margin="0,0,0,12"/>
                            <Button Content="打开链接" Width="110" Click="OpenLink_Click"
                                    Background="#6D5DF7" Foreground="White" BorderThickness="0" Padding="10,8"/>
                        </StackPanel>
                        <Image x:Name="ImagePreview" Stretch="Uniform" Visibility="Collapsed"/>
                        <MediaElement x:Name="MediaPreview" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                      Visibility="Collapsed" Stretch="Uniform"/>
                        <StackPanel x:Name="FileInfoPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="这是一个文件记忆" FontSize="18" Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="FileInfoText" Foreground="#9AA3BA" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"/>
                            <Button x:Name="OpenFileButton" Content="打开文件" Width="110" Margin="0,18,0,0" Click="OpenFile_Click"
                                    Background="#6D5DF7" Foreground="White" BorderThickness="0" Padding="10,8"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button x:Name="DeleteButton" Content="删除" Width="84" Margin="0,0,10,0" Click="Delete_Click"
                                Background="#4A1529" Foreground="#FF7E9E" BorderThickness="0" Padding="10,8"/>
                        <Button Content="编辑" Width="84" Margin="0,0,10,0" Click="Edit_Click"
                                Background="Transparent" Foreground="#C5CBE0" BorderBrush="#34405D" BorderThickness="1" Padding="10,8"/>
                        <Button Content="关闭" Width="84" Click="Close_Click"
                                Background="#6D5DF7" Foreground="White" BorderThickness="0" Padding="10,8"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>