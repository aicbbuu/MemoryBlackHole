<Window x:Class="MemoryBlackHole.Views.AddItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="新增" Height="500" Width="600" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent" Foreground="#E9ECF5"
        Opacity="0.80">
    <shell:WindowChrome.WindowChrome>
        <!-- v3.0.3 重打(问题2): CornerRadius 与外层 Border CornerRadius=12 保持一致,四角圆角才完整;
             ResizeBorderThickness 改 0(用户失去边缘拖拽改大小,只能拖标题栏/最大化) -->
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="12"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="TypeRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#C4CCE0"/>
            <Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="9,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Box" Background="#2B3550" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#6D5DF7"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- v6.6.6: 「软件背景音乐(BGM)」单选按钮专用样式:基于 TypeRadio,但无论选中与否都保持橙色底 + 白字 -->
        <Style x:Key="TypeRadioBgm" TargetType="RadioButton" BasedOn="{StaticResource TypeRadio}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Box" Background="#E67E22" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DialogWindowButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C3CBDF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#37436A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!-- v3.0.3 重打(问题2): 外层 Border CornerRadius=12 与 WindowChrome.CornerRadius 一致;
         x:Name="WindowFrame" 供 StateChanged 最大化时负 Margin 补偿铺满工作区 -->
    <Border x:Name="WindowFrame" BorderBrush="#414D70" BorderThickness="1" CornerRadius="12" Background="#E51C2333">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- v3.0.3(问题2): 标题栏背景用带顶部左右圆角的 Border,不再以实心矩形盖住外层 Border 的顶部圆角 -->
            <Border Grid.Row="0" Background="#181D2A" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="新增" FontSize="13" FontWeight="SemiBold"
                               Foreground="#F5F7FF" VerticalAlignment="Center" Margin="18,0,0,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,6,0">
                        <Button Content="—" Style="{StaticResource DialogWindowButton}" Click="Minimize_Click"/>
                        <Button x:Name="MaximizeButton" Content="□" Style="{StaticResource DialogWindowButton}" Click="Maximize_Click"/>
                        <Button Content="×" Style="{StaticResource DialogWindowButton}" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="1" Padding="26">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="新增一条记忆" FontSize="23" FontWeight="Light" Foreground="White"/>
                    <TextBlock Grid.Row="1" Text="选择类型，然后填写内容或选择文件" FontSize="12" Foreground="#97A1BB" Margin="0,6,0,16"/>
                    <WrapPanel x:Name="TypePanel" Grid.Row="2" Margin="-3,0,0,14">
                        <RadioButton x:Name="RText" Content="📝 文本" IsChecked="True" Tag="Text" Style="{StaticResource TypeRadio}" Checked="Type_Changed"/>
                        <RadioButton x:Name="RImage" Content="🖼 图片" Tag="Image" Style="{StaticResource TypeRadio}" Checked="Type_Changed"/>
                        <RadioButton x:Name="RVVideo" Content="🎬 视频" Tag="Video" Style="{StaticResource TypeRadio}" Checked="Type_Changed"/>
                        <RadioButton x:Name="RAudio" Content="🎵 音频" Tag="Audio" Style="{StaticResource TypeRadio}" Checked="Type_Changed"/>
                        <RadioButton x:Name="RFile" Content="📄 文件" Tag="File" Style="{StaticResource TypeRadio}" Checked="Type_Changed"/>
                        <RadioButton x:Name="RLink" Content="🔗 链接" Tag="Link" Style="{StaticResource TypeRadio}" Checked="Type_Changed"/>
                        <RadioButton x:Name="RBGM" Content="🎵 软件背景音乐" Tag="BGM" Style="{StaticResource TypeRadioBgm}" Checked="Type_Changed"/>
                    </WrapPanel>
                    <Grid Grid.Row="3">
                        <TextBox x:Name="ContentBox" Background="#232B3E" BorderBrush="#414D70" Foreground="White"
                                 Padding="12" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto" ToolTip="输入文本内容"/>
                        <StackPanel x:Name="FilePanel" Visibility="Collapsed"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Top">
                            <TextBlock x:Name="BgmHint" Text="这里上传的是用于软件背景音乐的音频文件"
                                       Visibility="Collapsed"
                                       Foreground="#E67E22" FontSize="12" FontWeight="SemiBold"
                                       TextWrapping="Wrap" TextAlignment="Left"
                                       HorizontalAlignment="Stretch" Margin="0,0,0,10"/>
                            <TextBlock x:Name="GenericFileHint" Text="支持图片、视频、音频和其他文件。800MB 的文件分块流式存入本地 SQLite 数据库；超过阈值文件副本保存在 .memoryblackhole/files"
                                       Foreground="#B8C2D9" FontSize="12" LineHeight="20"
                                       TextWrapping="Wrap" TextAlignment="Left"
                                       HorizontalAlignment="Stretch" Margin="0,0,0,12"/>
                            <Button Content="选择本地文件" Width="150" Height="40" HorizontalAlignment="Left"
                                    Background="#6D5DF7" Foreground="White" BorderThickness="0" Cursor="Hand" Click="ChooseFile_Click"/>
                            <TextBlock x:Name="SelectedFileText" Text="尚未选择文件" Foreground="#97A1BB"
                                       FontSize="12" TextWrapping="Wrap" TextAlignment="Left"
                                       HorizontalAlignment="Stretch" Margin="0,14,0,0"/>
                            <ListBox x:Name="FileListBox" Background="#232B3E" BorderBrush="#414D70"
                                     BorderThickness="1" Margin="0,8,0,0" MaxHeight="140"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" Visibility="Collapsed"
                                     Foreground="#E9ECF5" FontSize="12"
                                     HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Padding="6,3" Foreground="#CED5E7"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="4" Margin="0,14,0,18">
                        <TextBlock x:Name="TagHintText" Text="标签(必含类型词,后面可自定义标签,可多个用逗号分隔)" Foreground="#97A1BB" FontSize="12" Margin="0,0,0,5"/>
                        <StackPanel Orientation="Horizontal">
                            <!-- v3.1.0: 固定类型词(不可删)+ 用户可编辑追加,确认时拼成 "类型词,用户词" -->
                            <Border Background="#6D5DF7" CornerRadius="4" Padding="8,4" VerticalAlignment="Center" Margin="0,0,6,0">
                                <TextBlock x:Name="FixedTagLabel" Text="文本" Foreground="White" FontSize="13"/>
                            </Border>
                            <!-- v3.0.1: 固定宽度 110,左对齐,不再随字数撑开 -->
                            <TextBox x:Name="TagsBox" Width="110" Height="28" Background="#232B3E" BorderBrush="#414D70"
                                     Foreground="White" Padding="10,6" VerticalContentAlignment="Center"
                                     HorizontalAlignment="Left"
                                     ToolTip="可自定义标签,可多个用逗号分隔"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Width="84" Margin="0,0,10,0" Click="Cancel_Click"
                                Background="Transparent" Foreground="#CED5E7" BorderBrush="#485574" BorderThickness="1" Padding="10,8"/>
                        <Button Content="确认" Width="110" Click="Confirm_Click"
                                Background="#6D5DF7" Foreground="White" BorderThickness="0" Padding="10,8"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>