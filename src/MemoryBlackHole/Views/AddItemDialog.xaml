<Window x:Class="MemoryBlackHole.Views.AddItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="丢进黑洞" Height="500" Width="500" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent" Foreground="#E9ECF5">
    <Window.Resources>
        <Style x:Key="TypeRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#B9C1D8"/>
            <Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="9,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Box" Background="#1C2438" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#6D5DF7"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#303B59" BorderThickness="1" CornerRadius="16" Background="#0F1424" Padding="26">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="新增一条记忆" FontSize="23" FontWeight="Light" Foreground="White"/>
            <TextBlock Grid.Row="1" Text="选择类型，然后填写内容或选择文件" FontSize="12" Foreground="#8991A8" Margin="0,6,0,16"/>
            <WrapPanel Grid.Row="2" Margin="-3,0,0,14">
                <RadioButton x:Name="RText" Content="📝 文本" IsChecked="True" Tag="Text" Style="{StaticResource TypeRadio}" Checked="Type_Changed"/>
                <RadioButton x:Name="RImage" Content="🖼 图片" Tag="Image" Style="{StaticResource TypeRadio}" Checked="Type_Changed"/>
                <RadioButton x:Name="RVVideo" Content="🎬 视频" Tag="Video" Style="{StaticResource TypeRadio}" Checked="Type_Changed"/>
                <RadioButton x:Name="RAudio" Content="🎵 音频" Tag="Audio" Style="{StaticResource TypeRadio}" Checked="Type_Changed"/>
                <RadioButton x:Name="RFile" Content="📄 文件" Tag="File" Style="{StaticResource TypeRadio}" Checked="Type_Changed"/>
                <RadioButton x:Name="RLink" Content="🔗 链接" Tag="Link" Style="{StaticResource TypeRadio}" Checked="Type_Changed"/>
            </WrapPanel>
            <Grid Grid.Row="3">
                <TextBox x:Name="ContentBox" Background="#171D30" BorderBrush="#303B59" Foreground="White"
                         Padding="12" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto" ToolTip="输入文本内容"/>
                <StackPanel x:Name="FilePanel" Visibility="Collapsed">
                    <TextBlock Text="接近 1 GiB 的文件可分块流式存入本地数据库；超过阈值时复制到本地文件目录（仅 win-x64 稳定支持）" Foreground="#AEB6CD" Margin="0,0,0,12"/>
                    <Button Content="选择本地文件" Width="150" Height="40" HorizontalAlignment="Left"
                            Background="#6D5DF7" Foreground="White" BorderThickness="0" Cursor="Hand" Click="ChooseFile_Click"/>
                    <TextBlock x:Name="SelectedFileText" Text="尚未选择文件" Foreground="#8991A8"
                               TextWrapping="Wrap" Margin="0,14,0,0"/>
                    <ListBox x:Name="FileListBox" Background="#171D30" BorderBrush="#303B59"
                             BorderThickness="1" Margin="0,8,0,0" MaxHeight="140"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" Visibility="Collapsed"
                             Foreground="#E9ECF5" FontSize="12">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Padding="6,3" Foreground="#C5CBE0"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="支持图片、视频、音频和其他文件。接近 1 GiB 的数据可分块存入本地 SQLite；超过阈值时文件副本保存在 .memoryblackhole/files。"
                               Foreground="#65708A" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="4" Margin="0,14,0,18">
                <TextBlock Text="标签（可选，用逗号分隔）" Foreground="#8991A8" FontSize="12" Margin="0,0,0,5"/>
                <TextBox x:Name="TagsBox" Height="38" Background="#171D30" BorderBrush="#303B59"
                         Foreground="White" Padding="10,8" VerticalContentAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Width="84" Margin="0,0,10,0" Click="Cancel_Click"
                        Background="Transparent" Foreground="#C5CBE0" BorderBrush="#34405D" BorderThickness="1" Padding="10,8"/>
                <Button Content="丢进黑洞" Width="110" Click="Confirm_Click"
                        Background="#6D5DF7" Foreground="White" BorderThickness="0" Padding="10,8"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
