<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="MemoryBlackHole.app"/>
  <!-- v3.1.0(问题:最大化窗口消失): 声明 Per-Monitor V2 DPI 感知。
       WPF 默认是 System-DPI-Aware;在混合缩放(单屏 150% / 双屏不同缩放)下,
       WM_GETMINMAXINFO 返回的物理像素与 SystemAware 进程被虚拟化的坐标不一致,
       会导致最大化后窗口被摆错位置/超出屏幕而"消失"。
       PerMonitorV2 让每个窗口按所在显示器 DPI 布局,物理像素的 WM_GETMINMAXINFO
       (见 NativeWindow.cs) 即被正确解释,单屏与多屏不同缩放下最大化都铺满当前工作区。 -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
